    <style name="Theme.DGLfilm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/fond</item>
        <item name="colorPrimaryVariant">@color/fond</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/fond</item>
        <item name="colorSecondaryVariant">@color/fond</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Barre de statut -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>